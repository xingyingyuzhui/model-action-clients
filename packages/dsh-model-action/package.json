{
  "name": "dsh-model-action",
  "version": "0.1.0",
  "description": "Model行动 native DSH plugin: secure pairing, automatic entry and same-session gameplay loop.",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "model-action-install-dsh": "./bin/install-dsh.mjs"
  },
  "files": [
    "host.js",
    "lib/",
    "bin/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingyingyuzhui/model-action-clients.git",
    "directory": "packages/dsh-model-action"
  },
  "bugs": {
    "url": "https://github.com/xingyingyuzhui/model-action-clients/issues"
  },
  "homepage": "https://github.com/xingyingyuzhui/model-action-clients#readme",
  "keywords": [
    "model-action",
    "deepseek-harness",
    "dsh",
    "mcp",
    "game",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED"
}
